<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>9</LangVersion>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Nucleus.Integrations.BlitzRelay</RootNamespace>
        <AssemblyName>Nucleus.Integrations.BlitzRelay</AssemblyName>
    </PropertyGroup>

    <!--
        The Unity folder is for Unity and nothing else: it names UnityEngine and UnityEditor, and this assembly must stay free of
        any game engine. Removing it here makes that the compiler's to enforce rather than a reviewer's to remember.
    -->
    <ItemGroup>
        <Compile Remove="Unity\**\*.cs"/>
        <None Include="Unity\**\*"/>
    </ItemGroup>

    <!-- Every reference is to a repository checked out beside this one, which is how the rest of this stack is laid out. -->
    <ItemGroup>
        <ProjectReference Include="..\..\Nucleus\Nucleus\Nucleus.csproj"/>
        <ProjectReference Include="..\..\SynapseSocket\SynapseSocket\SynapseSocket.csproj"/>
    </ItemGroup>

    <!-- The relay's own message framing. Only this integration references it: the engine does not know Blitz Relay exists. -->
    <ItemGroup>
        <ProjectReference Include="..\..\Other Projects\Blitz Relay With SynapseSocket\src\BlitzRelay.Protocol\BlitzRelay.Protocol.csproj"/>
    </ItemGroup>

    <!-- The migration coordinator this hands an ISessionHost to. Newfarm arrives through that project rather than directly:
         nothing in this assembly talks to a directory, and nothing in it knows what a session identity or an epoch is. -->
    <ItemGroup>
        <ProjectReference Include="..\..\Nucleus\Nucleus.Integrations.Newfarm\Nucleus.Integrations.Newfarm.csproj"/>
    </ItemGroup>

</Project>
